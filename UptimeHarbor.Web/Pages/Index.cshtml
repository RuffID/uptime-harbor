@page
@model IndexModel
@inject Microsoft.Extensions.Options.IOptions<UptimeHarbor.Infrastructure.Cluster.ClusterOptions> Cluster
@{
    ViewData["Title"] = "Панель мониторинга";
}

@if (Cluster.Value.Enabled)
{
    <partial name="_ClusterAdministration" model='@("Monitoring")' />
}
else
{
<section data-dashboard-root>
    <header class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <h1 class="h3 mb-0">Панель мониторинга</h1>
        <div class="badge rounded-pill text-bg-secondary px-3 py-2" data-signal-state role="status" aria-live="polite">
            <span data-signal-state-text>Подключаем автообновление…</span>
        </div>
    </header>

    <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
        <div class="d-flex flex-wrap align-items-end gap-2">
            <div>
                <label class="visually-hidden" for="dashboardSearch">Поиск</label>
                <input class="form-control form-control-sm w-auto mw-100"
                       size="36"
                       id="dashboardSearch"
                       name="dashboardSearch"
                       type="search"
                       autocomplete="off"
                       placeholder="Найти сервер или приложение"
                       data-dashboard-search />
            </div>
            <div>
                <label class="visually-hidden" for="dashboardType">Тип объекта</label>
                <select class="form-select form-select-sm" id="dashboardType" name="type" data-dashboard-type>
                    <option value="">Все типы</option>
                    <option value="Server">Серверы</option>
                    <option value="Application">Приложения</option>
                </select>
            </div>
            <div class="monitoring-status-filter flex-shrink-0">
                <label class="visually-hidden" for="dashboardStatus">Статус</label>
                <select class="form-select form-select-sm" id="dashboardStatus" name="status" data-dashboard-status>
                    <option value="">Все статусы</option>
                    <option value="1">Доступен</option>
                    <option value="2">Недоступен</option>
                    <option value="0">Неизвестно</option>
                </select>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary" type="button" data-dashboard-refresh>Обновить</button>
            @if (User.IsInRole(UptimeHarbor.Application.Security.ApplicationRoles.ADMINISTRATOR))
            {
                <button class="btn btn-sm btn-primary" type="button" data-monitoring-create>Создать</button>
            }
        </div>
    </div>

    <div class="card border-0 bg-body-tertiary" data-dashboard-state role="status" aria-live="polite">
        <div class="card-body py-5 text-center">
            <div class="spinner-border text-info mb-3" aria-hidden="true"></div>
            <p class="mb-0">Загружаем актуальное состояние…</p>
        </div>
    </div>

    <div data-dashboard-content hidden></div>
    @if (User.IsInRole(UptimeHarbor.Application.Security.ApplicationRoles.ADMINISTRATOR))
    {
        <partial name="_MonitoringEditor" />
    }
</section>
}

@section Scripts {
    @if (Cluster.Value.Enabled)
    {
        <partial name="_ClusterScripts" />
    }
    else
    {
    <script src="~/vendor/signalr/signalr.min.js" asp-append-version="true"></script>
    <script type="module" src="~/dist/pages/dashboard.js" asp-append-version="true"></script>
    }
}
