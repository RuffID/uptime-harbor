@page
@model UptimeHarbor.Web.Pages.Admin.ObjectsModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
ViewData["Title"] = "Сервера";
    string requestVerificationToken = Antiforgery.GetAndStoreTokens(ViewContext.HttpContext).RequestToken
        ?? throw new InvalidOperationException("Не удалось создать antiforgery token.");
}

<meta name="request-verification-token" content="@requestVerificationToken" />

<div class="d-flex flex-column gap-3" data-objects-page>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
<h1 class="h3 mb-0">Сервера</h1>
    </div>

    <div class="alert alert-danger d-none" role="alert" data-page-error></div>

    <div class="row g-3 align-items-start">
        <section class="col-12" aria-labelledby="servers-heading">
            <h2 id="servers-heading" class="h6 mb-2">Серверы</h2>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <div class="d-flex flex-wrap gap-2">
                    <label class="visually-hidden" for="serverSearch">Поиск серверов</label>
                    <input class="form-control form-control-sm w-auto mw-100" size="32" id="serverSearch" name="serverSearch" type="search" placeholder="Найти сервер" data-server-search />
                    <div class="monitoring-status-filter flex-shrink-0">
                        <label class="visually-hidden" for="serverStatusFilter">Статус сервера</label>
                        <select class="form-select form-select-sm w-auto" id="serverStatusFilter" name="serverStatus" data-server-status-filter>
                            <option value="">Все статусы</option><option value="1">Доступен</option><option value="2">Недоступен</option><option value="0">Неизвестно</option>
                        </select>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createServerModal">Создать сервер</button>
            </div>
            <div data-server-list></div>
            <p class="text-body-secondary text-center small m-0 p-4 d-none" data-server-empty>Серверов пока нет.</p>
        </section>

    </div>

    <div class="modal fade" id="editObjectModal" tabindex="-1" aria-labelledby="editObjectModalTitle" aria-hidden="true" data-edit-object-modal>
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="editObjectModalTitle">Редактирование сервера</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger d-none" role="alert" data-edit-object-error></div>

            <form class="card border-0 shadow-sm d-none" data-server-form novalidate>
                <div class="card-header bg-body-tertiary border-secondary-subtle py-3">
                    <h2 class="h5 mb-0" data-server-form-title>Сервер</h2>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="serverName">Имя</label>
                        <input class="form-control" id="serverName" name="name" type="text" maxlength="256" required data-server-name />
                        <div class="invalid-feedback" data-server-error="name"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="serverEndpointUrl">Адрес проверки</label>
                        <input class="form-control" id="serverEndpointUrl" name="endpointUrl" type="url" maxlength="2048" required data-server-endpoint />
                        <div class="invalid-feedback" data-server-error="endpointUrl"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="serverDescription">Описание</label>
                        <textarea class="form-control" id="serverDescription" name="description" maxlength="500" rows="3" data-server-description></textarea>
                        <div class="invalid-feedback" data-server-error="description"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="serverContainers">Контейнеры</label>
                        <select class="form-select" id="serverContainers" name="containerLinks" multiple data-server-containers></select>
                        <div class="form-text">Можно выбрать свободные контейнеры или убрать текущие связи.</div>
                        <div class="invalid-feedback" data-server-error="containerLinks"></div>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" id="serverMonitoringEnabled" name="isMonitoringEnabled" type="checkbox" role="switch" data-animated-switch data-server-enabled />
                        <label class="form-check-label" for="serverMonitoringEnabled">Мониторинг включён</label>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-secondary-subtle d-flex flex-wrap justify-content-between gap-2">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <div class="d-none" data-server-danger>
                        <button type="button" class="btn btn-outline-danger" data-action="delete-server">Удалить сервер</button>
                    </div>
                </div>
            </form>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Закрыть</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="createServerModal" tabindex="-1" aria-labelledby="createServerModalTitle" aria-hidden="true" data-create-server-modal>
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content border-0 shadow" data-create-server-form novalidate>
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="createServerModalTitle">Новый сервер</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger d-none" role="alert" data-create-server-general-error></div>
                    <div class="mb-3">
                        <label class="form-label" for="newServerName">Имя</label>
                        <input class="form-control" id="newServerName" name="name" type="text" maxlength="256" required data-create-server-name />
                        <div class="invalid-feedback" data-create-server-error="name"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="newServerEndpointUrl">Адрес проверки</label>
                        <input class="form-control" id="newServerEndpointUrl" name="endpointUrl" type="url" maxlength="2048" placeholder="https://example.org/health" required data-create-server-endpoint />
                        <div class="invalid-feedback" data-create-server-error="endpointUrl"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="newServerDescription">Описание</label>
                        <textarea class="form-control" id="newServerDescription" name="description" maxlength="500" rows="3" data-create-server-description></textarea>
                        <div class="invalid-feedback" data-create-server-error="description"></div>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" id="newServerMonitoringEnabled" name="isMonitoringEnabled" type="checkbox" role="switch" data-animated-switch checked data-create-server-enabled />
                        <label class="form-check-label" for="newServerMonitoringEnabled">Включить мониторинг</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary">Создать</button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script type="module" src="~/dist/pages/admin/objects.js" asp-append-version="true"></script>
}
