@page
@model UptimeHarbor.Web.Pages.Admin.NotificationsModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Telegram-уведомления";
    string requestVerificationToken = Antiforgery.GetAndStoreTokens(ViewContext.HttpContext).RequestToken
        ?? throw new InvalidOperationException("Не удалось создать antiforgery token.");
}

<meta name="request-verification-token" content="@requestVerificationToken" />

<div class="d-flex flex-column gap-3" data-notifications-page>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <h1 class="h3 mb-0">Telegram-уведомления</h1>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-primary" data-action="new-chat">Новый чат</button>
            <button type="button" class="btn btn-outline-primary" data-action="new-binding">Добавить привязку</button>
        </div>
    </div>

    <div class="alert alert-danger d-none" role="alert" data-page-error></div>
    <div class="card border-0 bg-body-tertiary" data-loading>
        <div class="card-body py-5 text-center">
            <div class="spinner-border text-info mb-3" aria-hidden="true"></div>
            <p class="mb-0">Загрузка…</p>
        </div>
    </div>

    <section class="d-none" data-content aria-label="Чаты Telegram">
        <div class="row g-3" data-chat-list></div>
        <div class="card border-0 shadow-sm d-none" data-chat-empty>
            <div class="card-body p-5 text-center text-body-secondary">Чатов пока нет.</div>
        </div>
    </section>

    <div class="modal fade" id="chatModal" tabindex="-1" aria-labelledby="chatModalTitle" aria-hidden="true" data-chat-modal>
        <div class="modal-dialog modal-dialog-centered">
            <form id="telegramChatForm" class="modal-content border-0 shadow" data-chat-form novalidate>
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="chatModalTitle" data-chat-form-title>Новый чат</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger d-none" role="alert" data-chat-general-error></div>
                    <div class="mb-3">
                        <label class="form-label" for="telegramChatId">ID чата Telegram</label>
                        <input class="form-control" id="telegramChatId" name="telegramChatId" type="number" required data-chat-id />
                        <div class="invalid-feedback" data-chat-error="telegramChatId"></div>
                    </div>
                    <div>
                        <label class="form-label" for="telegramChatName">Название</label>
                        <input class="form-control" id="telegramChatName" name="name" type="text" maxlength="200" required data-chat-name />
                        <div class="invalid-feedback" data-chat-error="name"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary" data-chat-save>Сохранить</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="bindingModal" tabindex="-1" aria-labelledby="bindingModalTitle" aria-hidden="true" data-binding-modal>
        <div class="modal-dialog modal-dialog-centered">
            <form id="notificationBindingForm" class="modal-content border-0 shadow" data-binding-form novalidate>
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="bindingModalTitle">Новая привязка</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger d-none" role="alert" data-binding-general-error></div>
                    <div class="mb-3">
                        <label class="form-label" for="bindingChatId">Чат</label>
                        <select class="form-select" id="bindingChatId" name="chatId" required data-binding-chat></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="bindingObjectKind">Тип объекта</label>
                        <select class="form-select" id="bindingObjectKind" name="objectKind" data-binding-kind>
                            <option value="1">Сервер</option>
                            <option value="2">Контейнер</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="bindingObjectId">Объект</label>
                        <select class="form-select" id="bindingObjectId" name="objectId" required data-binding-object></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary" data-binding-save>Добавить</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/dist/pages/admin/notifications.js" asp-append-version="true"></script>
}
