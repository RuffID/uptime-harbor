@page
@model UptimeHarbor.Web.Pages.Admin.NotificationsModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Telegram-уведомления";
    string requestVerificationToken = Antiforgery.GetAndStoreTokens(ViewContext.HttpContext).RequestToken
        ?? throw new InvalidOperationException("Не удалось создать antiforgery token.");
}

<meta name="request-verification-token" content="@requestVerificationToken" />

<div class="d-flex flex-column gap-4" data-notifications-page>
    <div>
        <h1 class="mb-1">Telegram-уведомления</h1>
        <p class="text-body-secondary mb-0">Чаты и привязки серверов и контейнеров.</p>
    </div>

    <div class="alert alert-danger d-none" role="alert" data-page-error></div>
    <div class="text-body-secondary" data-loading>Загрузка настроек…</div>

    <div class="row g-4 d-none" data-content>
        <section class="col-12 col-lg-6" aria-labelledby="chats-heading">
            <h2 id="chats-heading" class="h4">Чаты</h2>
            <div class="list-group mb-3" data-chat-list></div>
            <p class="text-body-secondary d-none" data-chat-empty>Чаты ещё не добавлены.</p>

            <form id="telegramChatForm" class="card" data-chat-form novalidate>
                <div class="card-body">
                    <h3 class="h5" data-chat-form-title>Новый чат</h3>
                    <div class="mb-3">
                        <label class="form-label" for="telegramChatId">Telegram chat ID</label>
                        <input class="form-control" id="telegramChatId" name="telegramChatId" type="number" required data-chat-id />
                        <div class="invalid-feedback" data-chat-error="telegramChatId"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="telegramChatName">Название</label>
                        <input class="form-control" id="telegramChatName" name="name" type="text" maxlength="200" required data-chat-name />
                        <div class="invalid-feedback" data-chat-error="name"></div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary" data-chat-save>Сохранить</button>
                        <button type="button" class="btn btn-outline-secondary d-none" data-action="cancel-chat">Отмена</button>
                        <button type="button" class="btn btn-outline-primary d-none" data-action="test-chat">Тест</button>
                        <button type="button" class="btn btn-outline-danger d-none" data-action="delete-chat">Удалить</button>
                    </div>
                </div>
            </form>
        </section>

        <section class="col-12 col-lg-6" aria-labelledby="bindings-heading">
            <h2 id="bindings-heading" class="h4">Привязки</h2>
            <div class="list-group mb-3" data-binding-list></div>
            <p class="text-body-secondary d-none" data-binding-empty>Привязок ещё нет.</p>

            <form id="notificationBindingForm" class="card" data-binding-form novalidate>
                <div class="card-body">
                    <h3 class="h5">Добавить привязку</h3>
                    <div class="mb-3">
                        <label class="form-label" for="bindingChatId">Чат</label>
                        <select class="form-select" id="bindingChatId" name="chatId" required data-binding-chat></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="bindingObjectKind">Тип объекта</label>
                        <select class="form-select" id="bindingObjectKind" name="objectKind" data-binding-kind>
                            <option value="1">Сервер</option>
                            <option value="2">Контейнер</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="bindingObjectId">Объект</label>
                        <select class="form-select" id="bindingObjectId" name="objectId" required data-binding-object></select>
                    </div>
                    <button type="submit" class="btn btn-primary" data-binding-save>Добавить</button>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/dist/pages/admin/notifications.js" asp-append-version="true"></script>
}
