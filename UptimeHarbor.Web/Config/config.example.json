    "PublicUri": "https://peer.example.invalid/internal/raft",
    "StoragePath": "C:/UptimeHarbor/cluster",
    "PeerListenPort": 8443,
    "TlsBoundary": "Direct",
    "TrustedProxyAddresses": [],
    "ClientCertificatePath": "C:/UptimeHarbor/keys/client.crt",
