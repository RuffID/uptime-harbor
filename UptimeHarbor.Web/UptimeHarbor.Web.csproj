<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;artifacts\**</DefaultItemExcludes>
    <CompileTypeScriptBeforeTargets>$(CompileTypeScriptBeforeTargets);ResolveCoreStaticWebAssets</CompileTypeScriptBeforeTargets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="6.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UptimeHarbor.Application\UptimeHarbor.Application.csproj" />
    <ProjectReference Include="..\UptimeHarbor.Infrastructure\UptimeHarbor.Infrastructure.csproj" />
  </ItemGroup>

</Project>
